#!/bin/bash
# 安装文件写入前：校验向导参数并落盘访问令牌。
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=common.sh
. "$SCRIPT_DIR/common.sh"

mkdir -p "$ETC" "$VAR"

token="${wizard_token:-}"
if [ ${#token} -lt 8 ]; then
  log_error "访问令牌至少 8 个字符，请返回上一步重新填写。"
  exit 1
fi

umask 077
printf '%s' "$token" > "$ETC/token"
chmod 600 "$ETC/token" 2>/dev/null || true

# 安装向导里填写的媒体库目录（英文冒号分隔），写入 extra_paths 供 common.sh 读取
media_paths="${wizard_media_paths:-}"
if [ -z "$media_paths" ]; then
  log_error "未填写媒体库目录。请返回上一步填写已存在的绝对路径（如 /vol1/1000/media），或安装后到「应用设置 → 授权目录」授权；授权前应用无法启动。"
  exit 1
fi

tmp_paths="$ETC/extra_paths.tmp"
: > "$tmp_paths"
IFS=':' read -ra media_path_list <<< "$media_paths"
seen=" "
invalid=0
for raw in "${media_path_list[@]}"; do
  path="${raw%/}"
  [ -n "$path" ] || path="/"
  case "$path" in
    /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/)
      log_error "媒体库目录不能是系统目录：$path"
      invalid=1
      continue
      ;;
    /*) ;;
    *)
      log_error "媒体库目录必须以 / 开头：$raw"
      invalid=1
      continue
      ;;
  esac
  if [ ! -d "$path" ]; then
    log_error "媒体库目录不存在：$path。请返回上一步修改，或先创建该目录。"
    invalid=1
    continue
  fi
  case "$seen" in
    *" $path "*) continue ;;
  esac
  seen="$seen$path "
  printf '%s\n' "$path" >> "$tmp_paths"
done
if [ "$invalid" -ne 0 ]; then
  rm -f "$tmp_paths"
  exit 1
fi
if [ ! -s "$tmp_paths" ]; then
  rm -f "$tmp_paths"
  log_error "没有可用的媒体库目录，安装已中止。请在向导中填写至少一个已存在的绝对路径。"
  exit 1
fi
umask 022
mv "$tmp_paths" "$ETC/extra_paths"
chmod 644 "$ETC/extra_paths" 2>/dev/null || true

port="${TRIM_SERVICE_PORT:-8669}"
case "$port" in
  ''|*[!0-9]*) port=8669 ;;
esac
printf '%s' "$port" > "$ETC/port"

# MCP 端口只用于宿主机 loopback 映射；端口占用时启动脚本会自动禁用 MCP
mcp_port="${NAS_MCP_PORT:-8670}"
case "$mcp_port" in
  ''|*[!0-9]*) mcp_port=8670 ;;
esac
if [ "$mcp_port" -lt 1 ] || [ "$mcp_port" -gt 65535 ]; then
  mcp_port=8670
fi
printf '%s' "$mcp_port" > "$ETC/mcp_port"

mkdir -p "$VAR/logs"
chmod 700 "$VAR" 2>/dev/null || true
exit 0
